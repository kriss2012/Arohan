# ISDP Local Institutional Environment Configuration
PROJECT_NAME="Institute Student Development Platform"
ENVIRONMENT=production
API_V1_STR=/api/v1
SECRET_KEY=isdp-institutional-secure-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local Database Configuration
# Local SQLite (Out-of-the-box):
DATABASE_URL=sqlite+aiosqlite:///./isdp_campus.db

# Local PostgreSQL (Dedicated LAN Server):
# DATABASE_URL=postgresql+asyncpg://isdp_admin:isdp_local_secure_password_2026@127.0.0.1:5432/isdp_campus_db

# Local Storage Roots
STORAGE_ROOT=./local_storage
BACKUP_ROOT=./local_storage/backups

# Local AI Configuration (Strictly Offline / Local Gateway)
AI_PROVIDER=local_deterministic
AI_MODEL=arohan-bkt-v1

# Institutional Meta
INSTITUTION_NAME="Institute of Management Research and Development, Shirpur"
INSTITUTION_CODE="IMRD"
